{
  "capabilities": {
    "streaming": true
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "description": "agent-mesh-lab agent: one model call per message",
  "name": "orchestrator",
  "skills": [
    {
      "description": "returns the model's answer to the message text",
      "id": "answer",
      "name": "answer",
      "tags": [
        "lab"
      ]
    }
  ],
  "supportedInterfaces": [
    {
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0",
      "url": "https://orchestrator.lab.svc.cluster.local:8080/"
    },
    {
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0",
      "url": "https://orchestrator.lab.svc.cluster.local:8080/"
    },
    {
      "protocolBinding": "GRPC",
      "protocolVersion": "1.0",
      "url": "https://orchestrator.lab.svc.cluster.local:8080"
    }
  ],
  "version": "0.0.0"
}

{
  "parentRefs": [
    {
      "group": "gateway.networking.k8s.io",
      "kind": "Gateway",
      "name": "agentgateway-ingress",
      "namespace": "agentgateway-ingress"
    }
  ],
  "rules": [
    {
      "backendRefs": [
        {
          "group": "agentgateway.dev",
          "kind": "AgentgatewayBackend",
          "name": "orchestrator-a2a",
          "weight": 1
        }
      ],
      "matches": [
        {
          "path": {
            "type": "PathPrefix",
            "value": "/"
          }
        }
      ]
    }
  ]
}

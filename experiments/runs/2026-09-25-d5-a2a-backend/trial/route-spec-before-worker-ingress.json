{
  "hostnames": [
    "worker.lab.internal"
  ],
  "parentRefs": [
    {
      "group": "gateway.networking.k8s.io",
      "kind": "Gateway",
      "name": "agentgateway-ingress",
      "namespace": "agentgateway-ingress"
    }
  ],
  "rules": [
    {
      "backendRefs": [
        {
          "group": "",
          "kind": "Service",
          "name": "worker",
          "port": 8080,
          "weight": 1
        }
      ],
      "matches": [
        {
          "path": {
            "type": "PathPrefix",
            "value": "/"
          }
        }
      ]
    }
  ]
}

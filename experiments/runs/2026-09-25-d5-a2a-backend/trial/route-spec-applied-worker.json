{
  "hostnames": [
    "worker.lab.svc.cluster.local"
  ],
  "parentRefs": [
    {
      "group": "gateway.networking.k8s.io",
      "kind": "Gateway",
      "name": "agw-central",
      "namespace": "agentgateway-waypoint",
      "sectionName": "inner-http"
    }
  ],
  "rules": [
    {
      "backendRefs": [
        {
          "group": "agentgateway.dev",
          "kind": "AgentgatewayBackend",
          "name": "worker-a2a",
          "weight": 1
        }
      ],
      "matches": [
        {
          "path": {
            "type": "PathPrefix",
            "value": "/"
          }
        }
      ]
    }
  ]
}

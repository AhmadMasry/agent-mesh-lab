# agent-mesh-lab .gitignore
# Principle: ignore build output, local state, secrets, and ephemeral logs.
# Never ignore pins or evidence — see "Deliberately committed" at the bottom.

### Go ###################################################################
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work
go.work.sum
bin/
dist/
# vendor/            # uncomment only if vendoring is adopted deliberately

### Python ###############################################################
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
*.egg-info/
.eggs/
build/
pip-wheel-metadata/
.ipynb_checkpoints/

### Editors ##############################################################
# JetBrains (GoLand, PyCharm) — ignore entirely; personal settings and indexes
.idea/
*.iml
out/
# VS Code — ignore personal settings, share recommended extensions
.vscode/*
!.vscode/extensions.json
# Vim / Emacs
*.swp
*.swo
*~
\#*\#

### OS ###################################################################
.DS_Store
.AppleDouble
Thumbs.db

### Secrets and local environment ########################################
.env
.env.*
!.env.example
kubeconfig
kubeconfig.*
*.kubeconfig
kube.config
*.pem
*.key
*.p12
*.pfx
*.tfvars
!*.tfvars.example

### Kubernetes / cloud tooling ###########################################
# Terraform (EKS fallback only)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Helm packaged charts (source charts and Chart.lock are committed)
charts/**/*.tgz
# Local cluster scratch
.kind/
tmp/
.tmp/

### Experiment artefacts #################################################
# Small CSV/JSONL run outputs cited by findings.md ARE committed under
# experiments/runs/<date>-<item>/. Only raw, large, or ephemeral output is ignored.
experiments/runs/**/raw/
experiments/runs/**/*.log
# Exception, B-5a (2026-09-22): that step's finding is about what a proxy's own log says while it shuts down, so
# the removed pod's log and its successor's ARE the run output, not raw output beside it. The negation covers every
# .log under that one run directory: 128 files, 1 099 lines, 141 304 bytes -- 64 proxy pod logs (oldpod.log 367
# lines, newpod.log 668 lines, 137 912 bytes together) and 64 one-line `kubectl apply` outputs (apply-1.log and
# apply-probe.log, 3 392 bytes together), which are kept for the same reason the rendered Job manifests beside them
# are. Every line was scanned for a host-identifying string and none was found (in-cluster pod names, cluster IPs,
# SPIFFE identities and trace ids only), so nothing is masked. Scoped to this one run directory.
!experiments/runs/2026-09-22-b5a-removal/**/*.log
# Exception, B-5b (2026-09-22): the same reason as B-5a's above -- this step's entries rest on what a removed proxy's
# own log says while it shuts down and on which pod answered each request, so the removed pod's log and its
# successor's ARE the run output. The negation covers every .log under that one run directory: 328 files, 2 405
# lines, 372 931 bytes -- 164 proxy pod logs (82 oldpod.log, 929 lines; 82 newpod.log, 1 312 lines; 363747 bytes
# together) and 164 one-line `kubectl apply` outputs (apply-1.log and apply-2.log, 9184 bytes together), which are
# kept for the same reason the rendered Job manifests beside them are. Every line was scanned for a
# host-identifying string: no host name, serial, device or product name, no power-assertion owner, no home path and
# no user name. Scoped to this one run directory.
!experiments/runs/2026-09-22-b5b-removal-resubscribe/**/*.log
*.pcap
*.pcapng
*.db
*.sqlite
*.sqlite3
*.jsonl.gz
*.csv.gz

### Deliberately committed (do not add to this file) #####################
# go.mod, go.sum                — Go pins
# uv.lock / poetry.lock / requirements*.txt — Python pins
# .python-version               — interpreter pin
# .ko.yaml                      — image build config
# .terraform.lock.hcl           — provider pins
# Chart.lock                    — chart dependency pins
# kind-config.yaml, deploy/**   — the reproducible environment
# versions.yaml, findings.md    — the point of the repo
